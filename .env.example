# ==============================================================================
# Solana Automated Arbitrage Platform - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env and configure appropriate values for your environment.

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=solana-arbitrage
APP_PORT=3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Solana Network & RPC Configuration
# ------------------------------------------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com/
SOLANA_COMMITMENT=confirmed
MAX_RPC_LATENCY_MS=1500

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=arbitrage
DATABASE_USER=arbitrage_user
DATABASE_PASSWORD=change_this_in_production_super_secure_pw
DATABASE_SSL=false
DATABASE_URL=postgresql://arbitrage_user:change_this_in_production_super_secure_pw@postgres:5432/arbitrage?schema=public

# ------------------------------------------------------------------------------
# In-Memory Cache (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password_in_production
REDIS_URL=redis://:change_this_redis_password_in_production@redis:6379/0

# ------------------------------------------------------------------------------
# Trading Mode & Risk Controls (Defaults to PAPER mode for Phase 1 safety)
# ------------------------------------------------------------------------------
TRADING_MODE=paper
WALLET_ENABLED=false

INITIAL_CAPITAL_USD=10.00
MAX_TRADE_USD=10.00
MIN_PROFIT_USD=0.01
MIN_ROI_PERCENT=0.05
MAX_SLIPPAGE_PERCENT=0.30
MIN_LIQUIDITY_USD=1000.00
MAX_QUOTE_AGE_MS=1000
MAX_DAILY_LOSS_USD=5.00
MAX_CONCURRENT_TRADES=1

# ------------------------------------------------------------------------------
# Market Monitoring Timers (in milliseconds)
# ------------------------------------------------------------------------------
PRICE_UPDATE_INTERVAL_MS=250
POOL_REFRESH_INTERVAL_MS=5000
OPPORTUNITY_SCAN_INTERVAL_MS=100

# ------------------------------------------------------------------------------
# DEX Adapters Configuration
# ------------------------------------------------------------------------------
RAYDIUM_ENABLED=true
ORCA_ENABLED=false

# ------------------------------------------------------------------------------
# Security & Administrative API
# ------------------------------------------------------------------------------
API_AUTH_ENABLED=true
JWT_SECRET=replace_with_at_least_32_characters_random_secret_string
API_RATE_LIMIT=100
